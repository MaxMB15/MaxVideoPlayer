{
	"identifier": "default",
	"description": "Default capabilities for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-set-fullscreen",
		"os:default",
		"dialog:default",
		"mpv:default",
		"store:default",
		"updater:default",
		"process:default",
		"opener:default",
		{
			"identifier": "shell:allow-execute",
			"allow": [{ "name": "binaries/ffmpeg", "sidecar": true, "args": true }]
		}
	]
}
